rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function registered() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'alomarmutlak@gmail.com' && request.auth.token.email_verified == true; }
    function ctlDoc() { return /databases/$(database)/documents/ctl/$(request.auth.uid); }
    function notBanned() { return !exists(ctlDoc()) || get(ctlDoc()).data.get('ban', false) != true; }
    function changesOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function canSpeak() { return registered() && notBanned() && (!exists(ctlDoc()) || get(ctlDoc()).data.get('mute',false) != true); }
    function nameKey(name) {
      return name.lower().replace('[ً-ٟـ]', '').replace('[إأآ]', 'ا').replace('ى','ي').replace('ة','ه').replace('[\\s_.-]', '').replace('/', '');
    }
    function validName(name, key) {
      return name is string && name.size() >= 3 && name.size() <= 14 && name.matches('^[؀-ۿa-zA-Z0-9 _.\\-]+$')
        && key.size() > 0 && key == nameKey(name);
    }
    function named(uid, name, key) {
      return key is string && key.size() > 0 && key.size() <= 100 && !key.matches('.*[/].*')
        && validName(name,key)
        && get(/databases/$(database)/documents/names/$(key)).data.uid == uid
        && get(/databases/$(database)/documents/names/$(key)).data.name == name;
    }
    function cleanCommunityText(text) {
      return text is string && text.size() >= 1 && text.size() <= 200 && text.trim().size() > 0
        && !text.lower().replace('[ً-ٟـ]', '').replace('[إأآ]', 'ا').replace('ى','ي').replace('ة','ه')
          .matches('(?s).*(كلب|حمار|غبي|تبن|زق|حقير|وصخ|fuck|shit|bitch|idiot|stupid).*');
    }
    function clanMember(id) { return exists(/databases/$(database)/documents/clans/$(id)) && request.auth.uid in get(/databases/$(database)/documents/clans/$(id)).data.members; }
    function channelMember(id) { return id == 'world' || clanMember(id); }

    match /users/{uid} {
      // The document contains the complete private save, not just a public profile.
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }
    match /names/{key} {
      allow read: if signedIn();
      allow create: if registered() && notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','at']) && request.resource.data.at is int
        && validName(request.resource.data.name,key);
      // Reusing a normalized name may change its display spelling, never its owner.
      allow update: if registered() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid && changesOnly(['name', 'at'])
        && validName(request.resource.data.name,key) && request.resource.data.at is int;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }
    match /ctl/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /cfg/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      function chatReport(r) {
        let m = get(/databases/$(database)/documents/chatRooms/$(r.room)/messages/$(r.messageId)).data;
        return registered() && notBanned() && channelMember(r.room)
          && r.keys().hasOnly(['type','by','byName','byKey','target','targetName','reason','note','room','messageId','at','createdAt','status'])
          && r.type == 'chat' && r.reason == 'chat' && id == request.auth.uid + '~' + r.messageId
          && r.target == m.uid && r.targetName == m.name && r.note == m.text
          && named(request.auth.uid,r.byName,r.byKey) && r.createdAt == request.time && r.at is int;
      }
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'open'
        && (request.resource.data.get('type','') == 'chat' ? chatReport(request.resource.data)
          : request.resource.data.get('reason','other') in ['voice','name','cheat','other']);
      allow read, update, delete: if isAdmin();
    }

    match /socialBlocks/{uid} {
      allow get: if registered() && request.auth.uid == uid;
      allow create, update: if registered() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uids','at']) && request.resource.data.uids is list
        && request.resource.data.uids.size() <= 1000 && request.resource.data.at == request.time;
    }
    match /presence/{uid} {
      function friends() {
        let pair = uid < request.auth.uid ? uid + '~' + request.auth.uid : request.auth.uid + '~' + uid;
        return get(/databases/$(database)/documents/friendships/$(pair)).data.status == 'accepted';
      }
      allow get: if registered() && notBanned() && (request.auth.uid == uid || isAdmin() || friends());
      allow create, update: if registered() && notBanned() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['seen','visible']) && request.resource.data.seen == request.time
        && request.resource.data.visible is bool;
    }
    match /chatLimits/{uid} {
      allow get: if registered() && request.auth.uid == uid;
      allow create, update: if canSpeak() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at','room','messageId']) && request.resource.data.at == request.time
        && (!exists(/databases/$(database)/documents/chatLimits/$(uid)) || request.time >= resource.data.at + duration.value(3,'s'))
        && !exists(/databases/$(database)/documents/chatRooms/$(request.resource.data.room)/messages/$(request.resource.data.messageId))
        && getAfter(/databases/$(database)/documents/chatRooms/$(request.resource.data.room)/messages/$(request.resource.data.messageId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/chatRooms/$(request.resource.data.room)/messages/$(request.resource.data.messageId)).data.at == request.time;
    }
    match /chatRooms/{room}/messages/{id} {
      allow get: if isAdmin() || (registered() && notBanned() && channelMember(room));
      allow list: if (isAdmin() || (registered() && notBanned() && channelMember(room))) && request.query.limit <= 50;
      allow create: if canSpeak() && channelMember(room)
        && request.resource.data.keys().hasOnly(['uid','name','nameKey','text','at'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
        && named(request.auth.uid,request.resource.data.name,request.resource.data.nameKey)
        && cleanCommunityText(request.resource.data.text)
        && getAfter(/databases/$(database)/documents/chatLimits/$(request.auth.uid)).data.at == request.time
        && getAfter(/databases/$(database)/documents/chatLimits/$(request.auth.uid)).data.messageId == id
        && getAfter(/databases/$(database)/documents/chatLimits/$(request.auth.uid)).data.room == room;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /clanMemberships/{uid} {
      allow get: if registered() && request.auth.uid == uid;
      allow create: if registered() && notBanned() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['clanId']) && request.resource.data.clanId is string
        && uid in getAfter(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.members;
      allow delete: if registered() && request.auth.uid == uid
        && !(uid in getAfter(/databases/$(database)/documents/clans/$(resource.data.clanId)).data.members);
    }
    match /clans/{id} {
      function shape(r) {
        return r.keys().hasOnly(['name','nameKey','tag','owner','members','names','nameKeys','createdAt'])
          && r.name is string && r.name.size() >= 3 && r.name.size() <= 24 && r.nameKey is string && r.nameKey.size() <= 100
          && r.tag is string && r.tag.size() >= 1 && r.tag.size() <= 4 && r.owner is string
          && r.members is list && r.members.size() <= 50 && r.members.toSet().size() == r.members.size()
          && r.names is map && r.nameKeys is map && r.names.keys().hasOnly(r.members) && r.names.keys().hasAll(r.members)
          && r.nameKeys.keys().hasOnly(r.members) && r.nameKeys.keys().hasAll(r.members) && r.createdAt is timestamp;
      }
      function membership() { return /databases/$(database)/documents/clanMemberships/$(request.auth.uid); }
      allow get: if registered() && notBanned();
      allow list: if registered() && notBanned() && request.query.limit <= 50;
      allow create: if registered() && notBanned() && shape(request.resource.data)
        && request.resource.data.owner == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.members == [request.auth.uid]
        && named(request.auth.uid,request.resource.data.names[request.auth.uid],request.resource.data.nameKeys[request.auth.uid])
        && !exists(membership()) && getAfter(membership()).data.clanId == id;
      allow update: if registered() && notBanned() && shape(request.resource.data)
        && changesOnly(['members','names','nameKeys'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.nameKeys.diff(resource.data.nameKeys).affectedKeys().hasOnly([request.auth.uid])
        && ((!(request.auth.uid in resource.data.members) && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && !exists(membership()) && getAfter(membership()).data.clanId == id
          && named(request.auth.uid,request.resource.data.names[request.auth.uid],request.resource.data.nameKeys[request.auth.uid]))
          || (request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && !existsAfter(membership())));
    }

    match /socialPrefs/{uid} {
      allow get: if registered() && request.auth.uid == uid;
      allow create, update: if registered() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['allowRequests']) && request.resource.data.allowRequests is bool;
    }

    // Real social links are private to their two members. They never expose /users saves.
    match /friendships/{linkId} {
      function member(r) { return request.auth.uid in r.members; }
      function shape(r) {
        return r.keys().hasOnly(['v','members','by','names','nameKeys','status','blocked','visible','createdAt','updatedAt','messages','seq'])
          && r.v == 1 && r.members is list && r.members.size() == 2
          && r.members[0] is string && r.members[1] is string
          && r.members[0].matches('^[A-Za-z0-9_-]{1,128}$') && r.members[1].matches('^[A-Za-z0-9_-]{1,128}$')
          && r.members[0] < r.members[1] && linkId == r.members[0] + '~' + r.members[1]
          && r.by in r.members && r.names is map && r.names.keys().hasOnly(r.members) && r.names.keys().hasAll(r.members)
          && r.nameKeys is map && r.nameKeys.keys().hasOnly(r.members) && r.nameKeys.keys().hasAll(r.members)
          && r.status in ['pending','accepted','closed','blocked']
          && r.blocked is list && r.blocked.size() <= 2 && r.blocked.toSet().size() == r.blocked.size() && r.blocked.hasOnly(r.members)
          && r.visible == (r.status == 'closed' ? [] : r.status == 'blocked' ? r.blocked : r.members)
          && (r.status == 'blocked' ? r.blocked.size() > 0 : r.blocked.size() == 0)
          && r.createdAt is timestamp && r.updatedAt == request.time
          && r.messages is list && r.messages.size() <= 20 && r.seq is int && r.seq >= 0;
      }
      function reservedName(r, uid) {
        let key = r.nameKeys[uid];
        return key is string && key.size() >= 1 && key.size() <= 100 && !key.matches('.*[/].*')
          && r.names[uid] is string && r.names[uid].size() >= 3 && r.names[uid].size() <= 14
          && get(/databases/$(database)/documents/names/$(key)).data.uid == uid
          && get(/databases/$(database)/documents/names/$(key)).data.name == r.names[uid];
      }
      function acceptsRequests(r) {
        let other = r.members[0] == request.auth.uid ? r.members[1] : r.members[0];
        let path = /databases/$(database)/documents/socialPrefs/$(other);
        let blocks = /databases/$(database)/documents/socialBlocks/$(other);
        return exists(path) && get(path).data.allowRequests == true
          && (!exists(blocks) || !(request.auth.uid in get(blocks).data.uids));
      }
      function identity(r) { return reservedName(r,r.members[0]) && reservedName(r,r.members[1]); }
      function stateChange(a,b) {
        return changesOnly(['status','blocked','visible','updatedAt']) && (
          (a.status == 'pending' && b.status == 'accepted' && a.by != request.auth.uid)
          || (a.status in ['pending','accepted'] && b.status == 'closed')
          || (!(request.auth.uid in a.blocked) && b.status == 'blocked' && b.blocked == a.blocked.concat([request.auth.uid]))
          || (request.auth.uid in a.blocked && b.blocked == a.blocked.removeAll([request.auth.uid])
            && b.status == (b.blocked.size() == 0 ? 'closed' : 'blocked')));
      }
      function reopen(a,b) {
        return a.status == 'closed' && b.status == 'pending' && b.by == request.auth.uid
          && request.time >= a.updatedAt + duration.value(60,'s')
          && changesOnly(['by','names','nameKeys','status','visible','updatedAt']) && identity(b) && acceptsRequests(b);
      }
      function chat(a,b) {
        let after = b.messages;
        let m = after.size() > 0 ? after[after.size()-1] : {};
        let kept = a.messages.size() < 20 ? a.messages : a.messages.removeAll([a.messages[0]]);
        return a.status == 'accepted' && changesOnly(['messages','seq','updatedAt'])
          && request.time >= a.updatedAt + duration.value(1,'s') && b.seq == a.seq + 1
          && (!exists(ctlDoc()) || get(ctlDoc()).data.get('mute',false) != true)
          && after == kept.concat([m]) && m.keys().hasOnly(['n','id','by','text','at'])
          && m.id is string && m.id.size() >= 1 && m.id.size() <= 160
          && m.n == b.seq && m.by == request.auth.uid && m.at is int && m.at >= 0
          && m.text is string && m.text.size() >= 1 && m.text.size() <= 240 && m.text.trim().size() > 0;
      }
      allow get: if registered() && notBanned() &&
        (exists(/databases/$(database)/documents/friendships/$(linkId)) ? member(resource.data) : request.auth.uid in linkId.split('~'));
      allow list: if registered() && notBanned() && request.query.limit <= 100 && request.auth.uid in resource.data.visible;
      allow create: if registered() && notBanned() && shape(request.resource.data) && member(request.resource.data)
        && request.resource.data.by == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.messages == [] && request.resource.data.seq == 0
        && (request.resource.data.status == 'blocked' ? reservedName(request.resource.data,request.auth.uid) : identity(request.resource.data))
        && ((request.resource.data.status == 'pending' && acceptsRequests(request.resource.data)) || (request.resource.data.status == 'blocked' && request.resource.data.blocked == [request.auth.uid]));
      allow update: if registered() && notBanned() && member(resource.data) && shape(request.resource.data)
        && request.resource.data.members == resource.data.members && request.resource.data.createdAt == resource.data.createdAt
        && (stateChange(resource.data,request.resource.data) || reopen(resource.data,request.resource.data) || chat(resource.data,request.resource.data));
      // A retained closed/blocked link prevents deleting and recreating it to bypass a block or cooldown.
      allow delete: if false;
    }

    match /rooms/{roomId} {
      function member(r) { return request.auth.uid == r.host || request.auth.uid == r.get('guest', null); }
      function validCreate(r) {
        return roomId.matches('^[A-Z0-9]{4}$') && r.code == roomId && r.protocol == 2
          && r.host == request.auth.uid && r.guest == null && r.state == 'wait'
          && r.matchId is string && r.matchId.size() > 0 && r.matchId.size() <= 200
          && r.moves == [] && r.messages == [] && r.voiceEpoch == 1 && r.resigned == null
          && r.keys().hasOnly(['code','protocol','matchId','host','hostName','hostPhoto','hostRating',
            'guest','guestName','state','moves','messages','voiceEpoch','resigned','created']);
      }
      function joining(a, b) {
        return a.state == 'wait' && a.guest == null && request.auth.uid != a.host
          && b.guest == request.auth.uid && b.guestProtocol == 2 && b.state == 'play'
          && changesOnly(['guest','guestProtocol','guestName','guestPhoto','guestRating','state']);
      }
      function heartbeat(a, b) {
        let field = request.auth.uid == a.host ? 'hostSeen' : 'guestSeen';
        return changesOnly([field]) && b.get(field, null) == request.time;
      }
      function move(a, b) {
        let n = a.moves.size();
        let m = b.moves.size() > n ? b.moves[n] : {};
        return a.state == 'play' && changesOnly(['moves']) && b.moves.size() == n + 1
          && b.moves == a.moves.concat([m]) && m.keys().hasOnly(['n','by','from','steps','caps'])
          && m.n == n && m.by == request.auth.uid && m.by == (n % 2 == 0 ? a.host : a.guest)
          && m.from is string && m.from.matches('^[0-7][0-7]$')
          && m.steps is string && m.steps.size() <= 256 && m.steps.matches('^[0-7][0-7](,[0-7][0-7])*$')
          && m.caps is string && m.caps.size() <= 256 && (m.caps == '' || m.caps.matches('^[0-7][0-7](,[0-7][0-7])*$'));
      }
      function chat(a, b) {
        let before = a.get('messages', []);
        let after = b.messages;
        let m = after.size() > 0 ? after[after.size() - 1] : {};
        let kept = before.size() < 40 ? before : before.removeAll([before[0]]);
        return a.state == 'play' && changesOnly(['messages']) && after.size() <= 40
          && after == kept.concat([m]) && m.keys().hasOnly(['id','by','q','at'])
          && m.by == request.auth.uid && m.id is string && m.id.size() <= 200
          && m.q is int && m.q >= 0 && m.q < 4 && m.at is int;
      }
      function voiceReset(a, b) {
        return changesOnly(['voiceEpoch','vOffer','vAnswer','hIce','gIce'])
          && b.voiceEpoch == a.get('voiceEpoch', 0) + 1
          && b.vOffer == null && b.vAnswer == null && b.hIce == [] && b.gIce == [];
      }
      function voice(a, b) {
        let host = request.auth.uid == a.host;
        let sdp = b.get(host ? 'vOffer' : 'vAnswer', null);
        let ice = b.get(host ? 'hIce' : 'gIce', []);
        return a.state == 'play' && changesOnly(host ? ['vOffer','hIce'] : ['vAnswer','gIce'])
          && (sdp == null || (sdp is string && sdp.size() <= 65536)) && ice is list && ice.size() <= 128;
      }
      function finish(a, b) {
        // Full board legality and competitive ratings still need a trusted game server.
        let r = b.get('result', {});
        return a.state == 'play' && changesOnly(['state','result']) && b.state == 'done'
          && r.keys().hasOnly(['winner','reason','plies']) && r.plies == a.moves.size()
          && (r.winner == null || r.winner == a.host || r.winner == a.guest)
          && r.reason is string && r.reason.size() <= 120;
      }
      function leaving(a, b) {
        return a.state == 'play' && changesOnly(['state','closedBy']) && b.state == 'closed' && b.closedBy == request.auth.uid;
      }
      function edit(a, b) {
        return joining(a, b) || (member(a) && (heartbeat(a, b) || move(a, b) || chat(a, b)
          || voiceReset(a, b) || voice(a, b) || finish(a, b) || leaving(a, b)));
      }
      // Open waiting rooms can be joined by code; active voice and moves are private.
      allow get: if isAdmin() || (registered() && notBanned() && (!exists(/databases/$(database)/documents/rooms/$(roomId))
        || member(resource.data) || (resource.data.state == 'wait' && resource.data.guest == null)));
      allow list: if isAdmin();
      allow create: if registered() && notBanned() && validCreate(request.resource.data);
      allow update: if registered() && notBanned() && resource.data.protocol == 2 && edit(resource.data, request.resource.data);
      allow delete: if registered() && request.auth.uid == resource.data.host && resource.data.state == 'wait';
    }
  }
}
