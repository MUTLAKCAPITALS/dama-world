rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function registered() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'alomarmutlak@gmail.com' && request.auth.token.email_verified == true; }
    function ctlDoc() { return /databases/$(database)/documents/ctl/$(request.auth.uid); }
    function notBanned() { return !exists(ctlDoc()) || get(ctlDoc()).data.get('ban', false) != true; }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }
    match /names/{key} {
      allow read: if signedIn();
      allow create: if registered() && request.resource.data.uid == request.auth.uid;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }
    match /ctl/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /cfg/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.host == request.auth.uid;
      allow update: if signedIn() && notBanned() && (
        request.auth.uid == resource.data.host ||
        request.auth.uid == resource.data.guest ||
        (resource.data.guest == null && request.resource.data.guest == request.auth.uid)
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.host;
    }
  }
}
